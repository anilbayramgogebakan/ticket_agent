# Copy this file to .env and fill in real values:
#     cp .env.example .env
#
# .env is gitignored; this template is committed. That way a new developer can
# see WHICH variables are needed without any secret ever entering the repo.

# GEMINI_API_KEY=""

# Optional: override the default model.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Pin an explicit version, not a moving alias like gemini-flash-latest:
# an alias changes what you call with nothing in git to explain why last
# month's results stopped reproducing.
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- Hugging Face --------------------------------------------------------
# Token from https://huggingface.co/settings/tokens (read access is enough).
# HF_TOKEN="hf_..."

# Any instruct-tuned model your token can reach. Expect weaker
# instruction-following than a frontier model — which is exactly why it is
# useful here: the repair loop finally has something to do.
# HF_MODEL="Qwen/Qwen2.5-1.5B-Instruct"
# HF_MODEL="Qwen/Qwen2.5-3B-Instruct"

# HF routes to third-party backends (together, fireworks-ai, nebius, ...).
# Leave unset for automatic routing; pin it when you need reproducibility,
# since routing changes are invisible in your code but visible in results.
# HF_PROVIDER="featherless-ai"


# Groq (groq.com) — LPU inference, open-weight models, free tier. Keys: gsk_...
# https://console.groq.com/keys
# GROQ_API_KEY="gsk_..."
